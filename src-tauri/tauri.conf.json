{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fluxxx",
  "version": "0.1.0",
  "identifier": "com.fluxxx.player",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "fluxxx",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "Lean Xtream Codes IPTV player",
    "longDescription": "fluxxx is a lean, snappy Windows player for Xtream Codes IPTV with a full EPG timeline grid, multi-provider curation, and a Discord Go-Live optimized window."
  }
}
